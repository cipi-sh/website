# Canonical origin https://cipi.sh — reinforce HTTPS at the browser
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# English homepage (and remaining /en/… tree)
/
  Content-Language: en
/en/*
  Content-Language: en

# Italian tree
/it/*
  Content-Language: it

# Error pages must never enter the index
/404.html
  X-Robots-Tag: noindex, nofollow
/en/404.html
  X-Robots-Tag: noindex, nofollow
/it/404.html
  X-Robots-Tag: noindex, nofollow

# Serve .sh files as plain text for piping to bash
/setup.sh
  Content-Type: text/plain; charset=utf-8

# Sitemap: text/xml triggers native browser XML/XSL view more reliably than application/xml
/sitemap.xml
  Content-Type: text/xml; charset=utf-8
  X-Content-Type-Options: nosniff

/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8

# LLM-friendly plain-text summaries
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# RFC 9116 security contact file
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
