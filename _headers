# Canonical origin https://cipi.sh — reinforce HTTPS at the browser
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Serve .sh files as plain text for piping to bash
/setup.sh
  Content-Type: text/plain; charset=utf-8

# Serve sitemap with correct content type
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# LLM-friendly plain-text summaries
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# RFC 9116 security contact file
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
