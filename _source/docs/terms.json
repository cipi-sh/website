  "auto-deploy": {
    "title": "A push deploys",
    "prompt": "you@laptop:~/shop$",
    "script": [
      {"c": "git commit -am \"checkout: round tax per line\" && git push"},
      {"o": [["To github.com:acme/shop.git   e4a8b1c..9d1f3a5  main -> main", "dim"]], "d": 600},
      {"c": "ssh cipi@203.0.113.10 sudo cipi deploy shop --history --limit=1", "wait": 1400},
      {"o": [["Deploy history — shop", "hl"]], "d": 400},
      {"o": [["  ✓ ", "ok"], ["published  release 133  58s  webhook push  github 140.82.115.14", ""]], "d": 200}
    ]
  },
  "db": {
