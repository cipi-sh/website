{
 "qs-install": {
  "title": "Install on a fresh Ubuntu server",
  "prompt": "root@vps:~#",
  "script": [
   {
    "c": "wget -O - https://cipi.sh/setup.sh | bash"
   },
   {
    "o": [
     [
      "Cipi 5.12.0 installer",
      "hl"
     ],
     [
      "  Ubuntu 24.04 LTS, KVM, 4 GB RAM",
      "dim"
     ]
    ]
   },
   {
    "o": "Paste your SSH public key:",
    "d": 400
   },
   {
    "o": [
     [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK3f…q9 you@laptop",
      "key"
     ]
    ],
    "d": 700
   },
   {
    "o": [
     [
      "✓ ",
      "ok"
     ],
     [
      "Key accepted",
      ""
     ]
    ]
   },
   {
    "o": "Proceed with the installation? [Y/n] y",
    "d": 600
   },
   {
    "bar": "Installing the stack ",
    "ms": 2400
   },
   {
    "o": [
     [
      "✓ ",
      "ok"
     ],
     [
      "Stack installed in 9m 41s",
      ""
     ]
    ]
   },
   {
    "o": "Have you saved these credentials? [y/N] y",
    "d": 600
   }
  ]
 },
