{
  "qs-install": {
    "title": "Install on a fresh Ubuntu server",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "wget -O - https://cipi.sh/setup.sh | bash"},
      {"o": [["Cipi 5.10.0 installer", "hl"], ["  Ubuntu 24.04 LTS, KVM, 4 GB RAM", "dim"]]},
      {"o": "Paste your SSH public key:", "d": 400},
      {"o": [["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK3f…q9 you@laptop", "key"]], "d": 700},
      {"o": [["✓ ", "ok"], ["Key accepted", ""]]},
      {"o": "Proceed with the installation? [Y/n] y", "d": 600},
      {"bar": "Installing the stack ", "ms": 2400},
      {"o": [["✓ ", "ok"], ["Stack installed in 9m 41s", ""]]},
      {"o": "Have you saved these credentials? [y/N] y", "d": 600}
    ]
  },
  "qs-login": {
    "title": "From your laptop",
    "prompt": "cipi@vps:~$",
    "script": [
      {"c": "ssh cipi@203.0.113.10", "p": "you@laptop:~$"},
      {"c": "sudo cipi status"},
      {"o": [["Cipi 5.10.0", "hl"], ["  up 12 min", "dim"]], "d": 300},
      {"o": "  CPU 3%    RAM 21% of 3.8 GB    Disk 9% of 76 GB"},
      {"o": [["  ● ", "ok"], ["nginx  ", ""], ["● ", "ok"], ["php8.5-fpm  ", ""], ["● ", "ok"], ["mariadb  ", ""], ["● ", "ok"], ["valkey  ", ""], ["● ", "ok"], ["supervisor", ""]]},
      {"c": "su root", "wait": 600, "nocopy": true},
      {"o": [["Password: ", "dim"], ["(the root password from the install summary)", "dim"]], "d": 300}
    ]
  },
  "qs-create": {
    "title": "cipi app create",
    "prompt": "cipi@vps:~$",
    "script": [
      {"c": "sudo cipi app create"},
      {"o": "App type   1) Laravel  2) Node  3) Custom     [1] 1", "d": 400},
      {"o": "Runtime    1) PHP-FPM  2) Octane (FrankenPHP) [1] 1", "d": 400},
      {"o": [["Username:   ", ""], ["myapp", "hl"]], "d": 500},
      {"o": [["Domain:     ", ""], ["myapp.com", "hl"]], "d": 400},
      {"o": [["Repository: ", ""], ["git@github.com:you/myapp.git", "hl"]], "d": 400},
      {"o": [["✓ ", "ok"], ["Deploy key can read you/myapp (main)", ""]], "d": 500},
      {"o": [["✓ ", "ok"], ["User   ", ""], ["✓ ", "ok"], ["Database (MariaDB)   ", ""], ["✓ ", "ok"], ["PHP-FPM 8.5   ", ""], ["✓ ", "ok"], ["Nginx → myapp.com", ""]], "d": 500},
      {"o": [["✓ ", "ok"], ["Worker (default queue)   ", ""], ["✓ ", "ok"], ["Scheduler + deploy trigger   ", ""], ["✓ ", "ok"], ["Deployer", ""]], "d": 400},
      {"o": [["Credentials are shown once: save them.", "warn"]], "d": 300}
    ]
  },
  "qs-deploy": {
    "title": "cipi deploy",
    "prompt": "cipi@vps:~$",
    "script": [
      {"c": "sudo cipi deploy myapp"},
      {"o": [["task ", "dim"], ["deploy:update_code", ""]], "d": 500},
      {"o": [["task ", "dim"], ["deploy:vendors", ""]], "d": 800},
      {"o": [["task ", "dim"], ["artisan:migrate", ""]], "d": 500},
      {"o": [["task ", "dim"], ["deploy:symlink", ""], ["   current → releases/1", "dim"]], "d": 400},
      {"o": [["✓ ", "ok"], ["Deploy completed  (release 1, 48s)", ""]], "d": 400}
    ]
  },
  "qs-ssl": {
    "title": "cipi ssl install",
    "prompt": "cipi@vps:~$",
    "script": [
      {"c": "sudo cipi ssl install myapp"},
      {"o": [["✓ ", "ok"], ["DNS: myapp.com → 203.0.113.10", ""]], "d": 500},
      {"o": [["✓ ", "ok"], ["Certificate for myapp.com (renews automatically)", ""]], "d": 1300},
      {"o": [["✓ ", "ok"], ["APP_URL=https://myapp.com", ""]], "d": 300}
    ]
  },
  "qs-panel": {
    "title": "API and panel",
    "prompt": "cipi@vps:~$",
    "script": [
      {"c": "sudo cipi api api.example.com"},
      {"o": [["✓ ", "ok"], ["DNS  ", ""], ["✓ ", "ok"], ["API + MCP  ", ""], ["✓ ", "ok"], ["Certificate  ", ""], ["✓ ", "ok"], ["Token", ""]], "d": 1400},
      {"c": "sudo cipi gui panel.example.com", "wait": 300},
      {"o": [["✓ ", "ok"], ["Panel installed  ", ""], ["✓ ", "ok"], ["Certificate  ", ""], ["✓ ", "ok"], ["Admin account", ""]], "d": 1500},
      {"o": [["Open ", "dim"], ["https://panel.example.com", "hl"]], "d": 300}
    ]
  },
  "install": {
    "title": "The installer, start to finish",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "wget -O - https://cipi.sh/setup.sh | bash"},
      {"o": [["Cipi 5.10.0 installer", "hl"]]},
      {"o": [["✓ ", "ok"], ["Ubuntu 24.04 LTS on KVM, public IPv4 203.0.113.10", ""]], "d": 400},
      {"o": "Paste your SSH public key:", "d": 300},
      {"o": [["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK3f…q9 you@laptop", "key"]], "d": 700},
      {"o": [["✓ ", "ok"], ["Key accepted  SHA256:3f9cQd…4Ws", ""]]},
      {"o": "Add another SSH public key? [y/N]", "d": 400},
      {"o": [["Plan: ", "info"], ["nginx, PHP 8.5, MariaDB, Valkey, Supervisor, Fail2ban, UFW, Certbot, Deployer", ""]], "d": 400},
      {"o": [["SSH:  ", "info"], ["cipi with your key only; root login disabled; passwords off", ""]], "d": 200},
      {"o": "Proceed with the installation? [Y/n] y", "d": 600},
      {"bar": "Packages and services ", "ms": 2200},
      {"bar": "Hardening: SSH, UFW, Fail2ban ", "ms": 900},
      {"o": [["✓ ", "ok"], ["Installed in 9m 41s", ""]]},
      {"o": [["Root      ", "key"], ["User: root      Password: ••••••••••••••••", ""]], "d": 300},
      {"o": [["MariaDB   ", "key"], ["User: root      Password: ••••••••••••••••", ""]], "d": 150},
      {"o": [["Valkey    ", "key"], ["User: default   Password: ••••••••••••••••", ""]], "d": 150},
      {"o": "Have you saved these credentials? [y/N] y", "d": 600},
      {"o": "Where are your repositories? 1) GitHub 2) GitLab 3) Bitbucket 4) Azure DevOps (Enter to skip)", "d": 400},
      {"o": "Install the panel API now? [y/N]   Install the web GUI on this server now? [y/N]", "d": 500}
    ]
  },
  "create-app": {
    "title": "The app wizard",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi app create"},
      {"o": "App type   1) Laravel  2) Node (spa / static / ssr)  3) Custom   [1] 1", "d": 400},
      {"o": "Runtime    1) PHP-FPM  2) Octane (FrankenPHP)              [1] 2", "d": 500},
      {"o": "Database   1) MariaDB  2) PostgreSQL                       [1] 2", "d": 500},
      {"o": [["Username: ", ""], ["api", "hl"], ["   Domain: ", ""], ["api.example.com", "hl"]], "d": 500},
      {"o": [["Repository: ", ""], ["git@github.com:acme/api.git", "hl"], ["   Branch: main   PHP: 8.5", ""]], "d": 500},
      {"o": [["Asset build (Enter to skip): ", ""], ["npm ci && npm run build", "hl"]], "d": 500},
      {"o": [["✓ ", "ok"], ["Deploy key can read acme/api (main)", ""]], "d": 500},
      {"o": [["→ ", "info"], ["Creating user...", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["User   ", ""], ["✓ ", "ok"], ["Directories   ", ""], ["✓ ", "ok"], ["Deploy key", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Database (PostgreSQL)   ", ""], ["✓ ", "ok"], [".env with DB, Valkey (own instance) + webhook", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Skipped (Octane)   ", ""], ["✓ ", "ok"], ["Nginx → api.example.com", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Worker + Octane (:8001)   ", ""], ["✓ ", "ok"], ["Scheduler + deploy trigger   ", ""], ["✓ ", "ok"], ["Deployer + asset build", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Deploy key and push webhook added on GitHub", ""]], "d": 400}
    ]
  },
  "deploy": {
    "title": "Deploy, list releases, roll back",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi deploy shop"},
      {"o": [["task ", "dim"], ["deploy:prepare", ""]], "d": 300},
      {"o": [["task ", "dim"], ["deploy:update_code", ""], ["    main @ 9d1f3a5", "dim"]], "d": 500},
      {"o": [["task ", "dim"], ["deploy:vendors", ""]], "d": 900},
      {"o": [["task ", "dim"], ["artisan:migrate", ""]], "d": 500},
      {"o": [["task ", "dim"], ["artisan:optimize", ""]], "d": 300},
      {"o": [["task ", "dim"], ["deploy:symlink", ""], ["        current → releases/133", "dim"]], "d": 300},
      {"o": [["task ", "dim"], ["artisan:queue:restart", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Deploy completed  (release 133, 1m43s)", ""]], "d": 400},
      {"c": "cipi deploy shop --releases", "wait": 500},
      {"o": [["Releases for 'shop'", "hl"]], "d": 200},
      {"o": "  133  2026-10-27 05:30  1m43s  9d1f3a5  hotfix: checkout tax rounding   (current)"},
      {"o": "  132  2026-10-26 08:30    45s  e4a8b1c  orders: export to CSV"},
      {"c": "cipi deploy shop --rollback", "wait": 500},
      {"o": [["✓ ", "ok"], ["Rollback done  (now on release 132)", ""]], "d": 500}
    ]
  },
  "ssl": {
    "title": "Certificates",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi ssl install shop"},
      {"o": [["✓ ", "ok"], ["DNS: shop.example.com → 203.0.113.10", ""]], "d": 500},
      {"o": [["✓ ", "ok"], ["DNS: www.shop.example.com → 203.0.113.10", ""]], "d": 200},
      {"o": [["→ ", "info"], ["Requesting a Let's Encrypt certificate...", ""]], "d": 300},
      {"o": [["✓ ", "ok"], ["Certificate for shop.example.com, www.shop.example.com", ""]], "d": 1400},
      {"o": [["✓ ", "ok"], ["HTTPS vhost, HTTP → HTTPS   ", ""], ["✓ ", "ok"], ["APP_URL=https://shop.example.com", ""]], "d": 300},
      {"c": "cipi ssl install shop --dns=cloudflare", "wait": 600, "nocopy": true},
      {"o": [["Behind the Cloudflare proxy: ", "dim"], ["DNS-01 validation, works with the orange cloud on", "dim"]], "d": 300}
    ]
  },
  "backup": {
    "title": "Backups to S3",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi backup configure"},
      {"o": [["→ ", "info"], ["AWS Access Key ID / Secret / Bucket / Region / Endpoint", ""]], "d": 400},
      {"o": [["✓ ", "ok"], ["Bucket acme-backups reachable", ""]], "d": 700},
      {"c": "cipi backup profile add nightly --scope=all --cron='0 2 * * *' --keep-days=14 --dest=s3", "wait": 300},
      {"o": [["✓ ", "ok"], ["Profile nightly: files + databases, every day at 02:00, kept 14 days", ""]], "d": 500},
      {"c": "cipi backup run --profile=nightly", "wait": 300},
      {"bar": "shop, api, blog → s3://acme-backups/cipi/nightly ", "ms": 2000},
      {"o": [["✓ ", "ok"], ["3 apps, 3 databases, 412 MB, encrypted", ""]], "d": 300}
    ]
  },
  "gui-install": {
    "title": "Install the panel",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi api api.example.com"},
      {"o": [["✓ ", "ok"], ["DNS: api.example.com → 203.0.113.10", ""]], "d": 400},
      {"o": [["✓ ", "ok"], ["REST API + MCP   ", ""], ["✓ ", "ok"], ["Certificate   ", ""], ["✓ ", "ok"], ["Token with full access", ""]], "d": 1400},
      {"c": "cipi gui panel.example.com", "wait": 300},
      {"o": [["✓ ", "ok"], ["DNS: panel.example.com → 203.0.113.10", ""]], "d": 400},
      {"o": "Admin name: Alice Admin   Email: alice@example.com", "d": 400},
      {"bar": "Laravel + cipi/gui ", "ms": 1800},
      {"o": [["✓ ", "ok"], ["Certificate   ", ""], ["✓ ", "ok"], ["Admin account", ""]], "d": 300},
      {"o": [["Open ", "dim"], ["https://panel.example.com", "hl"], [" and turn on two-factor login in Settings.", "dim"]], "d": 300}
