  "api": {
    "title": "Install the API and create a token",
    "prompt": "root@vps:~#",
    "script": [
      {"c": "cipi api api.example.com"},
      {"o": [["✓ ", "ok"], ["DNS   ", ""], ["✓ ", "ok"], ["API installed   ", ""], ["✓ ", "ok"], ["Certificate", ""]], "d": 1400},
      {"c": "cipi api token create --name=ci --abilities=apps-view,deploy-manage", "wait": 300},
      {"o": [["Token: ", ""], ["4|kH2s…redacted", "key"], ["  (shown once)", "dim"]], "d": 500},
      {"c": "curl -s -H \"Authorization: Bearer $TOKEN\" https://api.example.com/api/apps", "p": "you@laptop:~$", "wait": 500},
      {"o": "[{\"name\":\"shop\",\"domain\":\"shop.example.com\",\"php\":\"8.5\",\"type\":\"laravel\"}, …]", "d": 500}
    ]
  },
  "cli-client": {
    "title": "cipi-cli on your laptop",
    "prompt": "you@laptop:~$",
    "script": [
      {"c": "cipi-cli api token add prod"},
      {"o": "Cipi API endpoint: https://api.example.com", "d": 400},
      {"o": "API token: 1|yourtoken...", "d": 400},
      {"o": [["Server profile \"prod\" saved → ~/.cipi/config.json", ""]], "d": 300},
      {"c": "cipi-cli status", "wait": 300},
      {"o": [["NAME      IP              CPU   RAM   APPS  CIPI", "dim"]], "d": 400},
      {"o": "prod*     203.0.113.10    12%   48%   6     5.10.0"},
      {"o": "staging   203.0.113.20     4%   31%   2     5.10.0"},
      {"c": "cipi-cli staging deploy myapp", "wait": 300},
      {"o": [["✓ ", "ok"], ["Deployed to release #14. Zero downtime.", ""]], "d": 1400}
    ]
  },
