# Host/protocol canonicalization: https://cipi.sh (see functions/_middleware.js).
# Cloudflare Pages _redirects only support path-based rules, not www/http.
#
# Language + legacy page redirects (/, /docs/*, /guides/*, /alternatives, *.html, …)
# are handled in functions/_middleware.js so they can honour Accept-Language and
# the cipi-lang cookie. /en uses English slugs; /it uses Italian slugs
# (slug map lives in functions/_middleware.js).

# Redirect installer URLs to GitHub raw (avoids 500 when hosting can't serve .sh)
/setup.sh  https://raw.githubusercontent.com/cipi-sh/cipi/refs/heads/latest/setup.sh  302

# Retired sponsorship pages → language home (middleware then picks /en or /it)
/sponsorship    /  301
/sponsorship/*  /  301
